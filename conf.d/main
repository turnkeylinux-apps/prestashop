#!/bin/bash -ex

ADMIN_MAIL=admin@example.com
ADMIN_PASS=turnkey1
DOMAIN=www.example.com # set via inithook 
DB_NAME=prestashop
DB_USER=prestashop
DB_PASS=$(mcookie)

WEBROOT=/var/www/prestashop
SRC=/usr/local/src
PRESTASHOP_VERSION=9.1.5
PRESTASHOP_EDITION=5.0
PRESTASHOP_SHA256=37140cb77c03acf61b832f76893cd8fe1e304b0fc14fa5485cfea4a7bfaf3a72
PRESTASHOP_ARCHIVE=prestashop-classic-${PRESTASHOP_VERSION}-${PRESTASHOP_EDITION}.zip
AUTOUPGRADE_VERSION=7.6.5
AUTOUPGRADE_SHA256=8cbf4b8b615bceef4710bb95708099fc5f2f64671c8196f475c87a76d6f7a2e1
AUTOUPGRADE_ARCHIVE=autoupgrade-v${AUTOUPGRADE_VERSION}.zip

# Unpack the official two-level production installer away from the document
# root, then install the supported Update Assistant release.
install -d /tmp/prestashop-installer "$WEBROOT"
unzip -q "$SRC/$PRESTASHOP_ARCHIVE" -d /tmp/prestashop-installer
unzip -q /tmp/prestashop-installer/prestashop.zip -d "$WEBROOT"
unzip -q "$SRC/$AUTOUPGRADE_ARCHIVE" -d "$WEBROOT/modules"
rm -rf /tmp/prestashop-installer
rm -f "$SRC/$PRESTASHOP_ARCHIVE" "$SRC/$AUTOUPGRADE_ARCHIVE"

# required for installer
chown -R www-data:www-data "$WEBROOT"

# convenience execution variables
MYSQL_BATCH="mysql --user=root --password=$MYSQL_PASS --batch"
MYSQL_ADMIN="mysqladmin --user=root --password=$MYSQL_PASS"

# start mysql server
service mysql start

# create database
$MYSQL_ADMIN create "$DB_NAME"

# create database user with privileges on the database
$MYSQL_BATCH --execute "CREATE USER '$DB_USER'@'localhost' IDENTIFIED BY '$DB_PASS'; GRANT ALL PRIVILEGES ON $DB_NAME.* TO '$DB_USER'@'localhost'; FLUSH PRIVILEGES;"

# update apache configuration
a2dissite 000-default
a2enmod headers
a2ensite prestashop
a2enmod rewrite

# prestashop installation and configuration
service apache2 start

su -p -s '/bin/sh' -c "php $WEBROOT/install/index_cli.php --timezone='US/Eastern' --domain='$DOMAIN' --db_user='$DB_USER' --db_password='$DB_PASS' --prefix='' --name='TurnKey PrestaShop' --country='us' --firstname='Presta' --lastname='Admin' --password='$ADMIN_PASS' --email='$ADMIN_MAIL' --ssl=1" www-data

rm -rf "$WEBROOT/install"
mv "$WEBROOT/admin" "$WEBROOT/administration"
cd "$WEBROOT"
su -p -s /bin/sh -c 'php ./bin/console prestashop:module install autoupgrade' www-data

install -d /usr/local/share/turnkey
printf '%s\n' \
    "version=$PRESTASHOP_VERSION" \
    "edition=$PRESTASHOP_EDITION" \
    'source=https://assets.prestashop3.com/dst/edition/corporate/' \
    "archive_sha256=$PRESTASHOP_SHA256" \
    "autoupgrade_version=$AUTOUPGRADE_VERSION" \
    "autoupgrade_sha256=$AUTOUPGRADE_SHA256" \
    > /usr/local/share/turnkey/prestashop-source

# Set permissions for normal setup
find "$WEBROOT" -type d -exec chmod 755 {} ";"
find "$WEBROOT" -type f -exec chmod 644 {} ";"
chmod -R +w app/config var/logs cache config download img mails modules override themes translations upload var

# required for friendly urls
touch $WEBROOT/.htaccess
touch $WEBROOT/robots.txt

chown -R www-data:www-data "$WEBROOT"

# enable ssl
$MYSQL_BATCH --execute "UPDATE $DB_NAME.configuration SET value = '1' WHERE name = 'PS_SSL_ENABLED';"
$MYSQL_BATCH --execute "UPDATE $DB_NAME.configuration SET value = '1' WHERE name = 'PS_SSL_ENABLED_EVERYWHERE';"

su -p -s /bin/sh -c 'php ./bin/console cache:clear --no-warmup --env=prod' www-data

# stop services
service apache2 stop
service mysql stop
